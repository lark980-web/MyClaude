import { createServer } from "node:http";
import { createProvider } from "../providers/openai.js";
import { createAgent } from "../agent/runtime.js";
import { allRegisteredTools, registerTools, multiEditTool, todoWriteTool, webFetchTool } from "../tools/index.js";
import { EXTENDED_TOOLS } from "../tools/extended.js";
import { loadConfig, saveConfig } from "../config.js";
import { resolveAttachments, describeAttachment } from "../attachments.js";
import { createAutoSaver, listSessions, latestSession, loadSession, pruneSessions } from "../session.js";

const PAGE = String.raw`<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="google" content="notranslate">
<meta name="robots" content="notranslate">
<meta http-equiv="Content-Language" content="en">
<title>MyClaude</title>
<style>
  :root{
    --bg:#131110; --panel:#1c1917; --panel2:#262221; --border:#3a3431;
    --text:#edeae7; --dim:#a39c96; --accent:#d97757; --accent-soft:#d9775733;
    --green:#a3d977; --red:#e8837a; --yellow:#e0b341;
  }
  *{box-sizing:border-box}
  html,body{height:100%;margin:0}
  body{background:var(--bg);color:var(--text);font:14px/1.6 "SF Mono",ui-monospace,Menlo,Consolas,monospace;display:flex;flex-direction:column}
  header{display:flex;align-items:center;gap:10px;padding:10px 18px;background:var(--panel);border-bottom:1px solid var(--border)}
  .brand{font-weight:700;color:var(--accent);letter-spacing:.3px;display:flex;align-items:center;gap:8px}
  .brand .logo{color:var(--accent);font-size:16px;letter-spacing:-2px}
  .chip{background:var(--panel2);border:1px solid var(--border);border-radius:6px;padding:2px 9px;color:var(--dim);font-size:12px}
  .chip b{color:var(--text);font-weight:600}
  header .spacer{flex:1}
  header select,header input{background:var(--panel2);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:4px 8px;font:inherit;font-size:12px}
  header button{background:var(--panel2);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:5px 12px;font:inherit;font-size:12px;cursor:pointer}
  header button:hover{border-color:var(--accent)}
  main{flex:1;overflow-y:auto;padding:20px 18px 8px}
  .wrap{max-width:880px;margin:0 auto}
  .welcome{padding:26px 0 10px;color:var(--dim)}
  .welcome .wlogo{color:var(--accent);font-size:15px;letter-spacing:-2px;white-space:pre;line-height:1.25}
  .welcome h1{color:var(--text);font-size:17px;margin:14px 0 6px;font-weight:700}
  .welcome h1 .ver{color:var(--dim);font-weight:400;font-size:13px;margin-left:6px}
  .welcome p{margin:3px 0;font-size:13px}
  .welcome kbd{background:var(--panel2);border:1px solid var(--border);border-radius:4px;padding:1px 6px;font-size:12px;color:var(--text)}
  .msg{margin-bottom:18px}
  .msg .who{font-size:11px;letter-spacing:.8px;text-transform:uppercase;color:var(--dim);margin-bottom:5px}
  .msg.user .who{color:var(--accent)}
  .msg .body{white-space:pre-wrap;word-break:break-word}
  .msg.user .body{color:var(--text)}
  .tool{margin:10px 0 14px}
  .tool-head{display:flex;align-items:baseline;gap:7px;cursor:pointer;user-select:none;padding:2px 0}
  .tool-head:hover .tool-name{color:var(--accent)}
  .tool-dot{color:var(--accent);font-size:11px}
  .tool-dot.run{color:var(--yellow)}
  .tool-dot.fail{color:var(--red)}
  .tool-name{color:var(--text);font-weight:600;transition:color .12s}
  .tool-args{color:var(--dim);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
  .tool-meta{color:var(--dim);font-size:11px;flex:none}
  .tool-out{display:none;margin:4px 0 2px 14px;padding-left:12px;border-left:1px solid var(--border)}
  .tool.open .tool-out{display:block}
  .tool-out .l{color:var(--dim);font-size:12px;white-space:pre-wrap;line-height:1.5}
  .tool-out .l::before{content:"\23BF  ";color:var(--border)}
  .tool-task .tool-dot,.tool-task .tool-name{color:#c792ea}
  .sys{color:var(--dim);font-size:12px;margin:10px 0}
  .sys.err{color:var(--red)} .sys.warn{color:var(--yellow)} .sys.ok{color:var(--green)}
  footer{border-top:1px solid var(--border);background:var(--panel);padding:12px 18px}
  .confirm{max-width:880px;margin:0 auto 12px;background:#2a2410;border:1px solid var(--yellow);border-radius:10px;padding:10px 14px}
  .confirm .row{display:flex;gap:8px;margin-top:8px}
  .confirm button{font:inherit;font-size:12px;border-radius:6px;padding:5px 14px;cursor:pointer;border:1px solid var(--border);background:var(--panel2);color:var(--text)}
  .confirm button.yes{background:var(--accent);color:#1a0f08;border-color:var(--accent);font-weight:700}
  .confirm button.no{background:transparent}
  .inputrow{max-width:880px;margin:0 auto;display:flex;gap:10px;align-items:flex-end}
  textarea{flex:1;background:var(--panel2);border:1px solid var(--border);border-radius:10px;color:var(--text);padding:10px 12px;font:inherit;resize:none;min-height:44px;max-height:220px;outline:none}
  textarea:focus{border-color:var(--accent)}
  textarea::placeholder{color:var(--dim)}
  .send{background:var(--accent);border:none;color:#1a0f08;font-weight:700;border-radius:10px;padding:0 18px;height:44px;cursor:pointer}
  .send:disabled{opacity:.4;cursor:default}
  .hint{max-width:880px;margin:8px auto 0;color:var(--dim);font-size:11px;display:flex;gap:14px}
  .hint .spacer{flex:1}
  .hint button{background:none;border:none;color:var(--dim);font:inherit;font-size:11px;cursor:pointer;padding:0}
  .hint button:hover{color:var(--accent)}
  /* attachments */
  .attach{max-width:880px;margin:0 auto 8px;display:flex;flex-wrap:wrap;gap:6px}
  .chip-file{display:flex;align-items:center;gap:6px;background:var(--panel2);border:1px solid var(--border);border-radius:6px;padding:3px 6px 3px 4px;font-size:11px;color:var(--text);max-width:280px}
  .chip-file img{width:26px;height:26px;object-fit:cover;border-radius:4px;display:block}
  .chip-file .ico{width:26px;height:26px;display:flex;align-items:center;justify-content:center;background:var(--panel);border-radius:4px;color:var(--accent);font-size:11px}
  .chip-file .nm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .chip-file .sz{color:var(--dim);flex:none}
  .chip-file .x{background:none;border:none;color:var(--dim);cursor:pointer;font:inherit;font-size:13px;line-height:1;padding:0 2px}
  .chip-file .x:hover{color:var(--red)}
  .dropzone{position:fixed;inset:0;background:#131110cc;border:2px dashed var(--accent);display:none;align-items:center;justify-content:center;color:var(--accent);font-size:16px;z-index:50;pointer-events:none}
  body.dragging .dropzone{display:flex}
  /* inline question / plan approval */
  .question{max-width:880px;margin:0 auto 12px;background:#1f1a26;border:1px solid #c792ea;border-radius:10px;padding:10px 14px}
  .question .qhead{color:#c792ea;font-weight:700;font-size:12px;margin-bottom:6px}
  .question .qtext{margin-bottom:8px;white-space:pre-wrap}
  .question .opt{display:flex;gap:8px;align-items:flex-start;padding:4px 0;cursor:pointer}
  .question .opt input{margin-top:3px}
  .question .opt .od{color:var(--dim);font-size:12px}
  .question .row{display:flex;gap:8px;margin-top:8px}
  .question input[type=text]{flex:1;background:var(--panel2);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:5px 8px;font:inherit;font-size:12px;outline:none}
  .question input[type=text]:focus{border-color:#c792ea}
  .question button{font:inherit;font-size:12px;border-radius:6px;padding:5px 14px;cursor:pointer;border:1px solid var(--border);background:var(--panel2);color:var(--text)}
  .question button.primary{background:var(--accent);color:#1a0f08;border-color:var(--accent);font-weight:700}
  .attachbtn{background:var(--panel2);border:1px solid var(--border);color:var(--text);border-radius:10px;height:44px;padding:0 12px;cursor:pointer;font-size:16px}
  .attachbtn:hover{border-color:var(--accent)}
  .attachbtn.vision-off{color:var(--dim)}
</style>
</head>
<body>
<header>
  <div class="brand"><span class="logo">&#9606;&#9501;&#9608;&#9608;&#9608;&#9500;&#9606;</span>MyClaude</div>
  <div class="chip">model <b id="m-model">-</b></div>
  <div class="chip">mode <b id="m-mode">-</b></div>
  <div class="chip">cwd <b id="m-cwd">-</b></div>
  <div class="spacer"></div>
  <select id="sel-mode" title="permission mode">
    <option value="ask">ask</option>
    <option value="auto">auto</option>
    <option value="plan">plan</option>
  </select>
  <button id="btn-vision" title="toggle vision (send image attachments to the model)">vision: on</button>
  <input id="in-model" size="16" placeholder="model">
  <button id="btn-model">set</button>
  <button id="btn-clear">clear</button>
</header>
<main><div class="wrap" id="log" translate="no">
  <div class="welcome" id="welcome" translate="no">
    <div class="wlogo">  &#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;
 &#9608;&#9608;  &#9608;&#9608;  &#9608;&#9608;&#9608;&#9608;
 &#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;
  &#9608;&#9608; &#9608;&#9608;&#9608;&#9608; &#9608;&#9608;</div>
    <h1>Welcome to MyClaude <span class="ver">v0.2.0</span></h1>
    <p id="w-meta">model - &middot; mode -</p>
    <p>Type a message to start. <kbd>Enter</kbd> send &middot; <kbd>Shift+Enter</kbd> newline &middot; <kbd>/help</kbd> commands</p>
  </div>
</div></main>
<footer>
  <div id="question-slot"></div>
  <div id="confirm-slot"></div>
  <div class="attach" id="attach-list"></div>
  <div class="inputrow">
    <input type="file" id="file-input" multiple hidden>
    <button class="attachbtn" id="btn-attach" title="Attach images or text files">&#128206;</button>
    <textarea id="in" rows="1" placeholder="Ask anything…  (Enter to send, Shift+Enter for newline, drop files to attach)"></textarea>
    <button class="send" id="send">Send</button>
  </div>
  <div class="hint"><span>/help</span><span id="stat"></span><span class="spacer"></span><span id="vision-hint"></span></div>
</footer>
<div class="dropzone">Drop files to attach</div>
<script>
const log = document.getElementById('log');
const welcome = document.getElementById('welcome');
const ta = document.getElementById('in');
const sendBtn = document.getElementById('send');
const attachList = document.getElementById('attach-list');
let busy = false;
let pendingAttachments = [];   // [{name, kind, mime, size, data|text, label, preview}]
let visionEnabled = true;

function el(tag, cls, text){ const e=document.createElement(tag); if(cls)e.className=cls; if(text!=null)e.textContent=text; return e; }
function scroll(){ const m=document.querySelector('main'); m.scrollTop=m.scrollHeight; }
function hideWelcome(){ if(welcome) welcome.style.display='none'; }
function clearLog(){
  [...log.children].forEach(c=>{ if(c.id!=='welcome') c.remove(); });
  const w=document.getElementById('welcome'); if(w) w.style.display='';
}

function addUser(text, files){
  hideWelcome();
  const m=el('div','msg user');
  m.appendChild(el('div','who','you'));
  if(files && files.length){
    const row=el('div','attach');
    for(const f of files){
      const chip=el('div','chip-file');
      if(f.preview){ const img=document.createElement('img'); img.src=f.preview; chip.appendChild(img); }
      else chip.appendChild(el('div','ico','txt'));
      chip.appendChild(el('span','nm',f.name));
      row.appendChild(chip);
    }
    m.appendChild(row);
  }
  m.appendChild(el('div','body',text));
  log.appendChild(m); scroll();
}
function addAssistant(text){
  hideWelcome();
  const m=el('div','msg');
  m.appendChild(el('div','who','myclaude'));
  const b=el('div','body'); b.textContent=text;
  m.appendChild(b); log.appendChild(m); scroll();
  return b;
}
function addSys(text, cls){ const d=el('div','sys'+(cls?' '+cls:''),text); log.appendChild(d); scroll(); }

// Rebuild the message log from a saved transcript (/continue, /resume).
function replayTranscript(messages){
  clearLog();
  for(const m of messages||[]){
    if(m.role==='user'){
      const parts=Array.isArray(m.content)?m.content:[];
      const text=typeof m.content==='string'?m.content
        :(parts.find(p=>p.type==='text')?.text||'');
      const imgs=parts.filter(p=>p.type==='image_url').length;
      if(text||imgs) addUser(text+(imgs?'  ['+imgs+' image(s)]':''),[]);
    } else if(m.role==='assistant' && m.content){
      addAssistant(String(m.content));
    }
  }
  scroll();
}

function addTool(call){
  hideWelcome();
  const box=el('div','tool');
  if(call.name==='Task') box.classList.add('tool-task');
  const head=el('div','tool-head');
  head.appendChild(el('span','tool-dot run','\u25CF'));
  head.appendChild(el('span','tool-name',call.name));
  head.appendChild(el('span','tool-args', summarize(call.args)));
  head.appendChild(el('span','tool-meta','running…'));
  const out=el('div','tool-out');
  head.onclick=()=>box.classList.toggle('open');
  box.appendChild(head); box.appendChild(out);
  log.appendChild(box); scroll();
  return {box, head, out};
}
function summarize(a){
  if(!a) return '';
  const parts=[];
  for(const [k,v] of Object.entries(a)){
    if(v==null) continue;
    let s=typeof v==='string'?v:JSON.stringify(v);
    s=s.replace(/\n/g,'\\n');
    if(s.length>70)s=s.slice(0,67)+'...';
    parts.push(k+': '+s);
    if(parts.length>=3)break;
  }
  return '('+parts.join(', ')+')';
}

function setBusy(v){
  busy=v; sendBtn.disabled=v;
  document.getElementById('stat').textContent = v?'working…':'';
}

async function send(){
  const text=ta.value.trim();
  const files=pendingAttachments.slice();
  if((!text&&!files.length)||busy) return;
  ta.value=''; ta.style.height='auto';
  if(text.startsWith('/')&&!files.length){ await command(text); return; }
  pendingAttachments=[]; renderAttachments();
  addUser(text, files);
  await stream('/api/chat',{message:text, attachments:files.map(stripPreview)});
}
function stripPreview(f){ const {preview, label, ...rest}=f; return rest; }

async function stream(url, body){
  setBusy(true);
  let bubble=null, buf='';
  const toolMap=new Map();
  try{
    const res=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    if(!res.ok){ addSys('HTTP '+res.status+': '+await res.text(),'err'); setBusy(false); return; }
    const reader=res.body.getReader(); const dec=new TextDecoder(); let line='';
    while(true){
      const {done,value}=await reader.read(); if(done)break;
      line+=dec.decode(value,{stream:true});
      let i;
      while((i=line.indexOf('\n'))>=0){
        const raw=line.slice(0,i).trim(); line=line.slice(i+1);
        if(!raw.startsWith('data:'))continue;
        const p=raw.slice(5).trim(); if(!p||p==='[DONE]')continue;
        let ev; try{ev=JSON.parse(p)}catch{continue}
        handleEvent(ev);
      }
    }
  }catch(e){ addSys('stream error: '+e.message,'err'); }
  setBusy(false);

  function handleEvent(ev){
    if(ev.type==='delta'){
      if(!bubble){ bubble=addAssistant(''); }
      buf+=ev.text; bubble.textContent=buf; scroll();
    } else if(ev.type==='assistant_end'){
      bubble=null; buf='';
    } else if(ev.type==='tool_start'){
      const rec=addTool(ev.call); toolMap.set(ev.call.id||ev.call.name, rec);
    } else if(ev.type==='tool_end'){
      const rec=[...toolMap.values()].reverse().find(r=>!r.done);
      if(rec){ rec.done=true;
        const dot=rec.head.querySelector('.tool-dot');
        dot.textContent=ev.ok?'\u25CF':'\u25CF';
        dot.className='tool-dot '+(ev.ok?'':'fail');
        rec.head.querySelector('.tool-meta').textContent=(ev.ok?'ok':'fail')+'\u00B7 '+ev.elapsed+'ms';
        const lines=String(ev.output||'').split('\n').filter(l=>l.length);
        rec.out.innerHTML='';
        for(const l of lines.slice(0,400)) rec.out.appendChild(el('div','l',l));
      }
    } else if(ev.type==='confirm'){
      showConfirm(ev);
    } else if(ev.type==='question'){
      showQuestion(ev);
    } else if(ev.type==='mode'){
      setModeChip(ev.permissionMode);
    } else if(ev.type==='info'){ addSys(ev.text); }
    else if(ev.type==='warn'){ addSys(ev.text,'warn'); }
    else if(ev.type==='error'){ addSys(ev.text,'err'); }
    else if(ev.type==='success'){ addSys(ev.text,'ok'); }
    else if(ev.type==='done'){ setBusy(false); }
  }
}

let pendingConfirmId=null;
function showConfirm(ev){
  pendingConfirmId=ev.id;
  const slot=document.getElementById('confirm-slot');
  slot.innerHTML='';
  const box=el('div','confirm');
  box.appendChild(el('div',null,'Allow tool: '+ev.name+' '+summarize(ev.args)));
  const row=el('div','row');
  const yes=el('button','yes','Allow'); const no=el('button','no','Deny');
  yes.onclick=()=>answerConfirm(true); no.onclick=()=>answerConfirm(false);
  row.appendChild(yes); row.appendChild(no); box.appendChild(row); slot.appendChild(box);
}
async function answerConfirm(ok){
  document.getElementById('confirm-slot').innerHTML='';
  await fetch('/api/confirm',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:pendingConfirmId,allow:ok})});
  pendingConfirmId=null;
}

function setModeChip(mode){
  document.getElementById('m-mode').textContent=mode;
  document.getElementById('sel-mode').value=mode;
}

let pendingQuestion=null;
function showQuestion(ev){
  pendingQuestion=ev;
  const slot=document.getElementById('question-slot');
  slot.innerHTML='';
  let idx=0; const answers=[];
  function render(){
    const q=ev.questions[idx];
    slot.innerHTML='';
    const box=el('div','question');
    box.appendChild(el('div','qhead', (ev.questions.length>1?('Q'+(idx+1)+'/'+ev.questions.length+' · '):'')+(q.header||'Question')));
    box.appendChild(el('div','qtext', q.question));
    const chosen=new Set();
    (q.options||[]).forEach((o,i)=>{
      const lab=el('label','opt');
      const inp=document.createElement('input');
      inp.type=q.multi_select?'checkbox':'radio';
      inp.name='q-opt';
      inp.onchange=()=>{
        if(q.multi_select){ if(inp.checked) chosen.add(o.label); else chosen.delete(o.label); }
        else { chosen.clear(); chosen.add(o.label); }
      };
      lab.appendChild(inp);
      const wrap=el('div');
      wrap.appendChild(el('div',null,o.label));
      wrap.appendChild(el('div','od',o.description||''));
      lab.appendChild(wrap);
      box.appendChild(lab);
    });
    const row=el('div','row');
    const free=document.createElement('input');
    free.type='text'; free.placeholder='or type a free-form answer';
    row.appendChild(free);
    const ok=el('button','primary','OK');
    ok.onclick=()=>{
      const val=free.value.trim();
      const ans=chosen.size?(q.multi_select?[...chosen]:[...chosen][0]):val;
      answers.push(ans||'');
      if(idx+1<ev.questions.length){ idx++; render(); }
      else answerQuestion(answers);
    };
    row.appendChild(ok);
    box.appendChild(row);
    slot.appendChild(box);
    free.focus();
    free.onkeydown=(e)=>{ if(e.key==='Enter'){ e.preventDefault(); ok.click(); } };
  }
  render();
}
async function answerQuestion(answers){
  const slot=document.getElementById('question-slot');
  slot.innerHTML='';
  const id=pendingQuestion?.id; pendingQuestion=null;
  await fetch('/api/answer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,answers})});
}

function renderAttachments(){
  attachList.innerHTML='';
  pendingAttachments.forEach((f,i)=>{
    const chip=el('div','chip-file');
    if(f.preview){ const img=document.createElement('img'); img.src=f.preview; chip.appendChild(img); }
    else chip.appendChild(el('div','ico','txt'));
    chip.appendChild(el('span','nm',f.name));
    chip.appendChild(el('span','sz', Math.max(1,Math.round((f.size||0)/1024))+'K'));
    const x=el('button','x','×');
    x.onclick=()=>{ pendingAttachments.splice(i,1); renderAttachments(); };
    chip.appendChild(x);
    attachList.appendChild(chip);
  });
}

function readFileAsDataURL(file){
  return new Promise((res,rej)=>{ const r=new FileReader(); r.onload=()=>res(r.result); r.onerror=rej; r.readAsDataURL(file); });
}
function readFileAsText(file){
  return new Promise((res,rej)=>{ const r=new FileReader(); r.onload=()=>res(r.result); r.onerror=rej; r.readAsText(file); });
}

async function addFiles(fileList){
  for(const file of fileList){
    const mime=file.type||'';
    if(mime.startsWith('image/')){
      if(file.size>5*1024*1024){ addSys(file.name+': image too large (max 5MB)','warn'); continue; }
      const url=await readFileAsDataURL(file);
      const b64=url.split(',')[1]||'';
      pendingAttachments.push({kind:'image',name:file.name,mime,size:file.size,data:b64,preview:url});
    } else if(/^text\/|json|xml|javascript|typescript|csv|markdown/.test(mime) || /\.(md|txt|json|js|ts|py|css|html|csv|ya?ml|toml|log)$/i.test(file.name)){
      if(file.size>200*1024){ addSys(file.name+': text file too large (max 200KB)','warn'); continue; }
      pendingAttachments.push({kind:'text',name:file.name,mime:mime||'text/plain',size:file.size,text:await readFileAsText(file)});
    } else {
      // Unknown binary: send the bytes and let the server describe it.
      if(file.size>5*1024*1024){ addSys(file.name+': file too large (max 5MB)','warn'); continue; }
      const url=await readFileAsDataURL(file);
      pendingAttachments.push({kind:'text',name:file.name,mime:mime||'application/octet-stream',size:file.size,data:(url.split(',')[1]||''),text:'(binary attachment — content not decoded)'});
    }
  }
  renderAttachments();
}

document.getElementById('btn-attach').onclick=()=>document.getElementById('file-input').click();
document.getElementById('file-input').onchange=(e)=>{ addFiles(e.target.files); e.target.value=''; };

// Drag & drop over the whole window.
let dragDepth=0;
window.addEventListener('dragenter',(e)=>{ if([...e.dataTransfer.types].includes('Files')){ dragDepth++; document.body.classList.add('dragging'); }});
window.addEventListener('dragleave',()=>{ if(--dragDepth<=0){ dragDepth=0; document.body.classList.remove('dragging'); }});
window.addEventListener('dragover',(e)=>{ if([...e.dataTransfer.types].includes('Files')) e.preventDefault(); });
window.addEventListener('drop',(e)=>{
  if(!e.dataTransfer.files.length) return;
  e.preventDefault(); dragDepth=0; document.body.classList.remove('dragging');
  addFiles(e.dataTransfer.files);
});

// Paste images/screenshots straight into the composer.
ta.addEventListener('paste',(e)=>{
  const items=[...(e.clipboardData?.items||[])];
  const files=items.filter(it=>it.kind==='file').map(it=>it.getAsFile()).filter(Boolean);
  if(files.length){ e.preventDefault(); addFiles(files); }
});

function renderVision(){
  const btn=document.getElementById('btn-vision');
  btn.textContent='vision: '+(visionEnabled?'on':'off');
  btn.classList.toggle('vision-off', !visionEnabled);
  document.getElementById('vision-hint').textContent=visionEnabled?'':'vision off — images are not sent';
  document.getElementById('btn-attach').classList.toggle('vision-off', !visionEnabled);
}
async function toggleVision(){
  visionEnabled=!visionEnabled;
  renderVision();
  await fetch('/api/config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({vision:visionEnabled})});
  addSys('vision '+(visionEnabled?'enabled':'disabled'), visionEnabled?'ok':'warn');
}
document.getElementById('btn-vision').onclick=toggleVision;

async function command(text){
  const [cmd,...rest]=text.slice(1).split(/\s+/); const arg=rest.join(' ');
  switch(cmd){
    case 'help': addSys('commands: /help /clear /model [name] /mode [ask|auto|plan] /attach <path> /detach /vision [on|off] /tools /config /sessions /continue'); break;
    case 'sessions': {
      const j=await (await fetch('/api/sessions')).json();
      const list=j.sessions||[];
      addSys(list.length
        ? list.map(s=>s.id+'  '+s.messages+' msgs  '+(s.updatedAt||s.savedAt)+'  '+(s.cwd||'')).join('\n')
        : '(no saved sessions)');
      break;
    }
    case 'continue': {
      const r=await fetch('/api/session',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'continue'})});
      if(!r.ok){ addSys('no previous session to continue','warn'); break; }
      const j=await r.json();
      replayTranscript(j.transcript||[]);
      addSys('continued '+j.messages+' messages from '+j.id,'ok');
      break;
    }
    case 'session': {
      const j=await (await fetch('/api/config')).json();
      addSys('session auto-saves to ~/.myclaude/sessions/ (model '+j.model+')');
      break;
    }
    case 'attach': {
      if(!arg){ addSys('usage: /attach <path> [more paths…]','warn'); break; }
      const r=await fetch('/api/attach',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({paths:arg.split(/\s+/).filter(Boolean)})});
      const j=await r.json();
      for(const a of j.attachments||[]){
        const item={kind:a.kind,name:a.name,mime:a.mime,size:a.size};
        if(a.kind==='image'){ item.data=a.data; item.preview='data:'+a.mime+';base64,'+a.data; }
        else if(a.kind==='text'){ item.text=a.text; }
        pendingAttachments.push(item);
      }
      for(const e of j.errors||[]) addSys(e.name+': '+e.error,'warn');
      renderAttachments();
      addSys((j.attachments||[]).length+' file(s) attached','ok');
      break;
    }
    case 'detach': pendingAttachments=[]; renderAttachments(); addSys('attachments cleared'); break;
    case 'vision': {
      if(arg==='on'||arg==='off'){ visionEnabled = arg==='on'; renderVision();
        await fetch('/api/config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({vision:visionEnabled})});
        addSys('vision '+arg,'ok'); }
      else addSys('vision = '+(visionEnabled?'on':'off'),'info');
      break;
    }
    case 'clear': clearLog(); addSys('cleared'); break;
    case 'tools': { const r=await fetch('/api/tools'); const j=await r.json(); addSys(j.tools.map(t=>t.name+' — '+t.description.split('.')[0]).join('\n')); break; }
    case 'config': { const r=await fetch('/api/config'); addSys(JSON.stringify(await r.json(),null,2)); break; }
    case 'model': {
      if(arg){ await fetch('/api/config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:arg})}); addSys('model = '+arg,'ok'); refreshMeta(); }
      else { const j=await (await fetch('/api/config')).json(); addSys('model = '+j.model); }
      break;
    }
    case 'mode': {
      if(['ask','auto','plan'].includes(arg)){ await fetch('/api/config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({permissionMode:arg})}); addSys('mode = '+arg,'ok'); refreshMeta(); }
      else addSys('usage: /mode ask|auto|plan','warn');
      break;
    }
    default: addSys('unknown command: /'+cmd,'warn');
  }
}

async function refreshMeta(){
  const j=await (await fetch('/api/config')).json();
  document.getElementById('m-model').textContent=j.model;
  document.getElementById('m-mode').textContent=j.permissionMode;
  document.getElementById('m-cwd').textContent=j.cwd;
  document.getElementById('sel-mode').value=j.permissionMode;
  document.getElementById('in-model').value=j.model;
  document.getElementById('w-meta').textContent='model '+j.model+' \u00B7 mode '+j.permissionMode+' \u00B7 '+j.cwd;
  visionEnabled = j.vision !== false;
  renderVision();
}

ta.addEventListener('keydown',(e)=>{
  if(e.key==='Enter'&&!e.shiftKey){ e.preventDefault(); send(); }
});
ta.addEventListener('input',()=>{ ta.style.height='auto'; ta.style.height=Math.min(ta.scrollHeight,220)+'px'; });
sendBtn.onclick=send;
document.getElementById('btn-clear').onclick=()=>{ clearLog(); addSys('cleared'); };
document.getElementById('btn-model').onclick=()=>{ const v=document.getElementById('in-model').value.trim(); if(v) command('/model '+v); };
document.getElementById('sel-mode').onchange=async (e)=>{
  const mode=e.target.value;
  const r=await fetch('/api/config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({permissionMode:mode})});
  const j=await r.json();
  setModeChip(j.permissionMode||mode);
  addSys('mode = '+(j.permissionMode||mode),'ok');
};

refreshMeta();
ta.focus();
</script>
</body>
</html>`;

export async function startGui({ config: initialConfig, port = 7788, open = true }) {
  const config = { ...initialConfig };
  const provider = createProvider(config);

  const sessions = new Map();
  const savers = new Map();
  let confirmResolvers = new Map();
  let questionResolvers = new Map();

  /** Auto-saver bound to one GUI conversation (persisted per browser session). */
  const saverFor = (key, agent) => {
    let saver = savers.get(key);
    if (!saver) {
      saver = createAutoSaver({
        getMessages: () => agent.messages,
        getMeta: () => ({
          cwd: process.cwd(),
          model: config.model,
          provider: config.provider,
          permissionMode: agent.mode ?? config.permissionMode,
          turnCount: agent.turnCount,
          version: "0.2.0",
          ui: "gui",
        }),
      });
      savers.set(key, saver);
    }
    return saver;
  };

  const sse = (res, event) => {
    res.write(`data: ${JSON.stringify(event)}\n\n`);
  };

  const makeUi = (res) => ({
    streamText: (t) => sse(res, { type: "delta", text: t }),
    endStream: () => sse(res, { type: "assistant_end" }),
    info: (t) => sse(res, { type: "info", text: t }),
    warn: (t) => sse(res, { type: "warn", text: t }),
    error: (t) => sse(res, { type: "error", text: t }),
    success: (t) => sse(res, { type: "success", text: t }),
    toolStart: (name, args) => sse(res, { type: "tool_start", call: { name, args } }),
    toolEnd: (name, ok, elapsed, output) => sse(res, { type: "tool_end", name, ok, elapsed, output }),
    confirmTool: (name, args) =>
      new Promise((resolve) => {
        const id = Math.random().toString(36).slice(2);
        confirmResolvers.set(id, resolve);
        sse(res, { type: "confirm", id, name, args });
        // unref: a pending prompt must not keep the process alive.
        setTimeout(() => {
          if (confirmResolvers.has(id)) {
            confirmResolvers.delete(id);
            resolve(false);
          }
        }, 120000).unref?.();
      }),
    /** AskUserQuestion / ExitPlanMode approval in the browser. */
    askQuestions: (questions) =>
      new Promise((resolve) => {
        const id = Math.random().toString(36).slice(2);
        questionResolvers.set(id, resolve);
        sse(res, { type: "question", id, questions });
        setTimeout(() => {
          if (questionResolvers.has(id)) {
            questionResolvers.delete(id);
            resolve(null);
          }
        }, 300000).unref?.();
      }),
  });

  const server = createServer(async (req, res) => {
    const url = new URL(req.url, `http://localhost:${port}`);

    if (url.pathname === "/" || url.pathname === "/index.html") {
      res.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
      res.end(PAGE);
      return;
    }

      if (url.pathname === "/api/config" && req.method === "GET") {
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(
        JSON.stringify({
          model: config.model,
          provider: config.provider,
          baseUrl: config.baseUrl,
          permissionMode: config.permissionMode,
          vision: config.vision !== false,
          cwd: process.cwd(),
          permissions: config.permissions || {},
          tools: (() => {
            registerTools([multiEditTool, todoWriteTool, webFetchTool, ...EXTENDED_TOOLS]);
            const agent = sessions.get("default");
            const list = agent
              ? agent.tools.map((t) => ({ name: t.function.name, description: t.function.description }))
              : allRegisteredTools().map((t) => ({ name: t.name, description: t.description }));
            return list;
          })(),
        })
      );
      return;
    }

    if (url.pathname === "/api/config" && req.method === "POST") {
      const body = await readJson(req);
      if (body.model) {
        config.model = body.model;
        provider.model = body.model;
        saveConfig({ model: body.model });
      }
      if (body.permissionMode && ["ask", "auto", "plan"].includes(body.permissionMode)) {
        config.permissionMode = body.permissionMode;
        saveConfig({ permissionMode: body.permissionMode });
        // Keep a live agent in sync so the new mode takes effect immediately.
        const agent = sessions.get("default");
        if (agent) agent.setMode(body.permissionMode);
      }
      if (typeof body.vision === "boolean") {
        config.vision = body.vision;
        saveConfig({ vision: body.vision });
        sessions.get("default")?.setVision(body.vision);
      }
      if (body.baseUrl) {
        config.baseUrl = body.baseUrl;
        provider.baseUrl = body.baseUrl.replace(/\/+$/, "");
        saveConfig({ baseUrl: body.baseUrl });
      }
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ ok: true, permissionMode: config.permissionMode, vision: config.vision !== false }));
      return;
    }

    if (url.pathname === "/api/mcp") {
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ servers: (sessions.get("default")?.mcpManager?.status?.() || []) }));
      return;
    }

    if (url.pathname === "/api/tools") {
      // Ensure the extended tool set is registered even before the first chat.
      registerTools([multiEditTool, todoWriteTool, webFetchTool]);
      const agent = sessions.get("default");
      const list = agent
        ? agent.tools.map((t) => ({ name: t.function.name, description: t.function.description }))
        : allRegisteredTools().map((t) => ({ name: t.name, description: t.description }));
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ tools: list }));
      return;
    }

    if (url.pathname === "/api/confirm" && req.method === "POST") {
      const body = await readJson(req);
      const resolve = confirmResolvers.get(body.id);
      if (resolve) {
        confirmResolvers.delete(body.id);
        resolve(!!body.allow);
      }
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ ok: true }));
      return;
    }

    if (url.pathname === "/api/answer" && req.method === "POST") {
      const body = await readJson(req);
      const resolve = questionResolvers.get(body.id);
      if (resolve) {
        questionResolvers.delete(body.id);
        resolve(body.answers ?? null);
      }
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ ok: true }));
      return;
    }

    if (url.pathname === "/api/attach" && req.method === "POST") {
      // Accepts { paths: string[] } or { files: [{ name, mime, data(base64) }] }
      // and returns normalized attachment descriptors the browser can render.
      const body = await readJson(req);
      const inputs = [];
      for (const p of body.paths || []) inputs.push({ path: p });
      for (const f of body.files || []) {
        if (!f?.data) continue;
        inputs.push({ kind: f.mime?.startsWith("image/") ? "image" : "text", name: f.name, mime: f.mime, data: f.data, size: f.size });
      }
      const resolved = await resolveAttachments(inputs);
      const ok = resolved.filter((a) => a.kind !== "error");
      const failed = resolved.filter((a) => a.kind === "error");
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(
        JSON.stringify({
          ok: true,
          attachments: ok.map((a) => ({ ...a, label: describeAttachment(a) })),
          errors: failed.map((a) => ({ name: a.name, error: a.error })),
        })
      );
      return;
    }

    if (url.pathname === "/api/chat" && req.method === "POST") {
      const body = await readJson(req);
      res.writeHead(200, {
        "Content-Type": "text/event-stream",
        "Cache-Control": "no-cache",
        Connection: "keep-alive",
      });

      const ui = makeUi(res);
      let agent = sessions.get("default");
      if (!agent) {
        agent = await createAgent({
          provider,
          config,
          ui,
          providerFactory: () => createProvider(config),
        });
        sessions.set("default", agent);
      } else {
        agent.setUi ? agent.setUi(ui) : (agent.ui = ui);
      }

      const saver = saverFor("default", agent);
      try {
        await agent.run(body.message, { attachments: body.attachments });
        agent.maybeCompact();
      } catch (e) {
        ui.error(`agent error: ${e.message}`);
      }
      // Persist the turn even if the browser tab closes mid-stream.
      const file = saver.save({ force: true });
      // The plan may have been approved mid-turn; report the live mode.
      sse(res, { type: "mode", permissionMode: agent.mode ?? config.permissionMode });
      sse(res, { type: "session", id: saver.id, file: file ?? null });
      sse(res, { type: "done" });
      res.end();
      return;
    }

    if (url.pathname === "/api/sessions" && req.method === "GET") {
      pruneSessions();
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ sessions: listSessions() }));
      return;
    }

    if (url.pathname === "/api/session" && req.method === "POST") {
      // { action: "resume", id } | { action: "continue" }
      const body = await readJson(req);
      const target =
        body.action === "resume" && body.id
          ? loadSession(body.id)
          : loadSession(latestSession({ cwd: process.cwd() })?.id ?? "");
      if (!target) {
        res.writeHead(404, { "Content-Type": "application/json" });
        res.end(JSON.stringify({ ok: false, error: "session not found" }));
        return;
      }
      let agent = sessions.get("default");
      if (!agent) {
        agent = await createAgent({
          provider,
          config,
          ui: makeUi({ write: () => {} }),
          providerFactory: () => createProvider(config),
        });
        sessions.set("default", agent);
      }
      agent.messages = target.messages || [];
      savers.get("default")?.rotate(target.id);
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(
        JSON.stringify({
          ok: true,
          id: target.id,
          messages: agent.messages.length,
          // The browser replays history from this transcript.
          transcript: agent.messages,
        })
      );
      return;
    }

    if (url.pathname === "/api/reset" && req.method === "POST") {
      savers.get("default")?.dispose();
      savers.delete("default");
      sessions.delete("default");
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ ok: true }));
      return;
    }

    res.writeHead(404, { "Content-Type": "text/plain" });
    res.end("not found");
  });

  await new Promise((resolve, reject) => {
    server.once("error", reject);
    server.listen(port, "127.0.0.1", resolve);
  });

  // Flush any pending auto-save when the GUI server shuts down.
  server.on("close", () => {
    for (const saver of savers.values()) saver.dispose();
    savers.clear();
  });

  // port 0 lets the OS pick a free port; report the one actually bound.
  const boundPort = server.address().port;
  const address = `http://127.0.0.1:${boundPort}`;
  if (open) {
    const cmd =
      process.platform === "win32"
        ? `start "" "${address}"`
        : process.platform === "darwin"
          ? `open "${address}"`
          : `xdg-open "${address}"`;
    import("node:child_process").then(({ exec }) => exec(cmd));
  }

  return { server, address };
}

function readJson(req) {
  return new Promise((resolve) => {
    let data = "";
    req.on("data", (c) => (data += c));
    req.on("end", () => {
      try {
        resolve(JSON.parse(data || "{}"));
      } catch {
        resolve({});
      }
    });
  });
}




