{
  "name": "myclaude",
  "version": "0.18.0",
  "description": "An original terminal coding agent with tool use, plus a Claude-style web GUI",
  "type": "module",
  "bin": {
    "myclaude": "bin/myclaude.js"
  },
  "scripts": {
    "dev": "node bin/myclaude.js --gui --port 3000 --no-open",
    "start": "node bin/myclaude.js --gui --port 3000 --no-open",
    "build:embed": "node scripts/bundle-gui.mjs",
    "build": "node scripts/bundle-gui.mjs",
    "gui": "node bin/myclaude.js --gui",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "esbuild": "^0.28.2",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.10.1",
    "ws": "^8.22.0"
  }
}
